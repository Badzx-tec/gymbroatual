# gymbro environment variables — DO NOT COMMIT `.env`
# Generate secrets with: bash scripts/gen-secrets.sh
# All <REPLACE_*> placeholders must be replaced before the app starts.

# --- MongoDB --------------------------------------------------------------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>
DB_NAME=gymbro

# --- Crypto / auth -------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=<REPLACE_WITH_RANDOM_BASE64_AT_LEAST_32_CHARS>
# Fernet keys: comma-separated list. First key is used to encrypt new data.
# Subsequent keys are tried during decrypt (enables zero-downtime rotation).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=<REPLACE_WITH_FERNET_KEY>
ENVIRONMENT=dev

# --- Super admin --------------------------------------------------------
# SUPER_ADMIN_PASSWORD must be a bcrypt hash (starts with $2). Generate with:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('YOUR_PASSWORD'))"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Platform Admin

# --- App URLs / CORS ----------------------------------------------------
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:80
# Production example:
# APP_BASE_URL=https://gymbro.dev.br
# FRONTEND_BASE_URL=https://gymbro.dev.br
# CORS_ORIGINS=https://gymbro.dev.br,https://www.gymbro.dev.br,https://admin.gymbr.dev.br

# --- Mercado Pago -------------------------------------------------------
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# MP_WEBHOOK_SECRET is REQUIRED when MP_ACCESS_TOKEN is set.
# When set, webhook requests missing X-Signature are rejected (fail-closed).
MP_WEBHOOK_SECRET=
MP_PREAPPROVAL_PLAN_ID=

# --- Billing ------------------------------------------------------------
TRIAL_DAYS=7
PAYMENT_GRACE_DAYS=3
SUBSCRIPTION_MONTHLY_AMOUNT=139.90
BILLING_RECONCILE_ENABLED=true
BILLING_RECONCILE_INTERVAL_SECONDS=900
BILLING_RECONCILE_BATCH_SIZE=200
STUDENT_BILLING_GRACE_DAYS=3
STUDENT_BILLING_RETRY_OFFSETS_DAYS=1,3,7

# --- SMTP --------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gymbro.local
SMTP_STARTTLS=true

# --- Gateway Toletus (catraca) ------------------------------------------
GATEWAY_DEVICE_ID=
GATEWAY_DEVICE_TOKEN=
SAAS_URL=http://backend:8000
SAAS_REQUEST_TIMEOUT=10
TOLETUS_SIMULATOR=true
TOLETUS_HOST=127.0.0.1
TOLETUS_PORT=7878
TOLETUS_READ_TIMEOUT=60
TOLETUS_RECONNECT_DELAY=3
TOLETUS_PROBE_ON_CONNECT=true
TOLETUS_PROBE_ON_TIMEOUT=true
TOLETUS_DEFAULT_DIRECTION=entry
TOLETUS_BIOMETRY_DEFAULT_DIRECTION=both
TOLETUS_DENY_DURATION_MS=2000
TOLETUS_DENY_BEEP=2
TOLETUS_DENY_LED=1
GATEWAY_MAX_SKEW_SECONDS=120
GATEWAY_NONCE_TTL_SECONDS=300
GATEWAY_INVALID_ATTEMPT_THRESHOLD=5
GATEWAY_BLOCK_SECONDS=600

# Gateway local da academia (sem backend/frontend/nginx locais):
# SAAS_URL=https://gymbro.dev.br
# GATEWAY_DEVICE_ID=dev_filial_01
# GATEWAY_DEVICE_TOKEN=token_gerado_no_saas
# TOLETUS_SIMULATOR=false
# TOLETUS_HOST=192.168.1.9
# TOLETUS_PORT=7878
# TOLETUS_DEFAULT_DIRECTION=entry
# TOLETUS_BIOMETRY_DEFAULT_DIRECTION=both

TOLETUS_MODE=mock
TOLETUS_API_BASE_URL=
TOLETUS_API_KEY=

# --- Rate limiting -----------------------------------------------------
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_VERIFY_RATE_LIMIT=5
AUTH_VERIFY_WINDOW_SECONDS=60
WEBHOOK_RATE_LIMIT=120
WEBHOOK_WINDOW_SECONDS=60

# --- Alerts ------------------------------------------------------------
ALERT_WEBHOOK_FAILURES_THRESHOLD=5
ALERT_ACCESS_DENIES_THRESHOLD=20
ALERT_GATEWAY_AUTH_FAILURES_THRESHOLD=10
